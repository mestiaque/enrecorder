{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: window controls and the folder/file pickers. Files and processes go through ENRecorder's own commands.",
  "windows": ["main", "hud", "region"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open"
  ]
}
