{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENRecorder",
  "mainBinaryName": "enrecorder",
  "version": "0.2.0",
  "identifier": "com.mestiaque.enrecorder",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ENRecorder",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#131315",
        "dragDropEnabled": false,
        "center": true,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "M. Estiaque Ahmed Khan",
    "category": "Video",
    "shortDescription": "Screen, audio and screenshot studio",
    "longDescription": "ENRecorder records your screen and audio and takes screenshots, then lets you trim, convert and export them. Local-first: no account, no upload, no watermark.",
    "copyright": "\u00a9 2026 M. Estiaque Ahmed Khan \u00b7 MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "section": "video",
        "desktopTemplate": "enrecorder.desktop",
        "depends": [
          "ffmpeg",
          "gstreamer1.0-pipewire",
          "gstreamer1.0-tools"
        ]
      },
      "rpm": {
        "desktopTemplate": "enrecorder.desktop",
        "depends": [
          "ffmpeg"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "homepage": "https://mestiaque.com"
  }
}
